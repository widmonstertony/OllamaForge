    "enable:macos-hybrid": "node macos/ollama-chatgpt-hybrid.mjs",
    "deploy:macos-metal": "node macos/metal-codex.mjs local",
    "restore:macos-metal": "node macos/metal-codex.mjs cloud",
    "install:macos-metal-shortcuts": "node macos/install-metal-shortcuts.mjs",
    "test:live": "node test-live-ollama.mjs"
