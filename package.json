{
  "name": "local-codex-ollama-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test-codex-ollama-adapter.mjs && node test-config.mjs && node test-macos-cloud-shortcut.mjs && node test-macos-ollama-chatgpt-hybrid.mjs && node test-macos-metal.mjs && node test-setup.mjs && node test-connect.mjs && node test-deploy.mjs && node test-strata-context-policy.mjs && node test-strata-bridge.mjs && node test-desktop-smoke.mjs && node test-deepseek-harness.mjs && node test-deepseek-recovery.mjs",
    "setup": "node connect.mjs",
    "connect": "node connect.mjs",
    "connect:deepseek": "node deepseek-harness.mjs connect",
    "connect:assistants": "node strata-assistants.mjs connect",
    "launch:assistants": "node strata-assistants.mjs launch",
    "repair:deepseek-workspace": "node deepseek-harness.mjs repair-workspace",
    "launch:deepseek": "node deepseek-harness.mjs launch",
    "stop:deepseek": "node deepseek-harness.mjs stop",
    "test:deepseek": "node deepseek-harness.mjs test",
    "test:deepseek-controls": "node test-deepseek-controls.mjs",
    "setup:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Setup-Strata.ps1",
    "start:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Start-StrataBackground.ps1 -Once",
    "restart:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Restart-Strata.ps1",
    "check:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Setup-Strata.ps1 -CheckHardware",
    "startup:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Install-StrataStartup.ps1",
    "startup:strata:disable": "powershell -NoProfile -ExecutionPolicy Bypass -File Install-StrataStartup.ps1 -Disable",
    "download:strata": "powershell -NoProfile -ExecutionPolicy Bypass -File Setup-Strata.ps1 -Install",
    "test:strata": "node test-strata-context-policy.mjs && node test-strata-bridge.mjs",
    "test:strata-policy": "node test-strata-context-policy.mjs",
    "test:desktop:prepare": "node desktop-smoke.mjs prepare",
    "test:desktop-policy": "node test-desktop-smoke.mjs",
    "test:strata-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File test-strata-startup.ps1",
    "test:strata-context": "node test-strata-context.mjs",
    "models": "node connect.mjs --list",
    "refresh": "node connect.mjs",
    "launch": "node connect.mjs --launch --no-shortcut",
    "disconnect": "node connect.mjs --disconnect",
    "deploy": "node connect.mjs",
    "download:27b": "node deploy.mjs",
    "deploy:27b": "node deploy.mjs",
    "prepare:alias": "node setup.mjs --no-pull",
    "install:macos-cloud-shortcut": "node macos/install-cloud-shortcut.mjs",
