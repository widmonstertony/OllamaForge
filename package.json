{
  "name": "local-codex-ollama-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test-codex-ollama-adapter.mjs && node test-config.mjs && node test-macos-cloud-shortcut.mjs && node test-macos-ollama-chatgpt-hybrid.mjs && node test-macos-metal.mjs && node test-setup.mjs && node test-connect.mjs && node test-deploy.mjs",
    "setup": "node connect.mjs",
    "connect": "node connect.mjs",
    "models": "node connect.mjs --list",
    "refresh": "node connect.mjs",
    "launch": "node connect.mjs --launch --no-shortcut",
    "disconnect": "node connect.mjs --disconnect",
    "deploy": "node connect.mjs",
    "download:27b": "node deploy.mjs",
    "deploy:27b": "node deploy.mjs",
    "prepare:alias": "node setup.mjs --no-pull",
    "install:macos-cloud-shortcut": "node macos/install-cloud-shortcut.mjs",
    "install:macos-direct-shortcut": "node macos/install-direct-shortcut.mjs",
    "enable:macos-hybrid": "node macos/ollama-chatgpt-hybrid.mjs",
    "deploy:macos-metal": "node macos/metal-codex.mjs local",
    "restore:macos-metal": "node macos/metal-codex.mjs cloud",
    "install:macos-metal-shortcuts": "node macos/install-metal-shortcuts.mjs",
    "test:live": "node test-live-ollama.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
